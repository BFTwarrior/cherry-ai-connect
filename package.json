{
  "name": "cherry-ai-connect",
  "version": "1.21.0",
  "description": "Cherry AI 连接中心 / Cherry AI Connect — 本地 AI 线路、客户端凭证、统计与加密同步",
  "main": "electron/main.js",
  "author": "BFTwarrior",
  "license": "MIT",
  "scripts": {
    "renderer:build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "start": "npm run renderer:build && electron .",
    "dist": "node scripts/prepare-dist.mjs && npm run check && npm run renderer:build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.bftwarrior.cherry-ai-connect",
    "productName": "Cherry AI 连接中心",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "electron/**/*",
      "gateway/*.mjs",
      "sync/*.mjs",
      "renderer/dist/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app.ico",
      "signExecutable": false,
      "artifactName": "Cherry-AI-Connect-Setup-1.21.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
