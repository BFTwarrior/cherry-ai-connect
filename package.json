{
  "name": "cherry-ai-connect",
  "version": "1.41.0",
  "description": "Cherry AI 连接中心 / Cherry AI Connect — 本地 AI 线路、客户端凭证、统计与加密同步",
  "main": "electron/main.js",
  "author": "BFTwarrior",
  "license": "MIT",
  "scripts": {
    "renderer:build": "vite build",
    "web-demo:build": "npm run renderer:build && node scripts/package-web-demo.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "start": "npm run renderer:build && electron .",
    "dist": "node scripts/prepare-dist.mjs && npm run protocol:build && npm run check && npm run renderer:build && electron-builder --win nsis && node scripts/verify-dist-size.mjs",
    "protocol:build": "node scripts/build-protocol-worker.mjs",
    "test:ui": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^31.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.bftwarrior.cherry-ai-connect",
    "productName": "Cherry AI 连接中心",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "electron/**/*",
      "!electron/assets/codex-usage-windows-amd64.exe",
      "!electron/assets/codex-*.tar*",
      "!electron/assets/codex-*.7z",
      "!electron/assets/codex-*.zip",
      "gateway/*.mjs",
      "sync/*.mjs",
      "renderer/dist/**/*",
      "!electron/assets/cherry-translator.exe",
      "!electron/assets/cherry-translator.exe.json"
    ],
    "directories": {
      "output": "dist/current-build"
    },
    "extraResources": [
      {
        "from": "electron/assets/app-1.33.ico",
        "to": "app-1.33.ico"
      },
      {
        "from": "electron/assets/codex-usage-windows-amd64.exe.tar.xz",
        "to": "codex-usage-windows-amd64.exe.tar.xz"
      },
      {
        "from": "electron/assets/cherry-translator.exe",
        "to": "cherry-translator.exe"
      },
      {
        "from": "electron/assets/cherry-translator.exe.json",
        "to": "cherry-translator.exe.json"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-1.33.ico",
      "signExecutable": false,
      "artifactName": "Cherry-AI-Connect-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "scripts/installer-icon.nsh"
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
